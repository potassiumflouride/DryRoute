# Copy this file to .env and fill in the values, or export them yourself
# before running deploy.sh. See README.md for where CLOUDFRONT_DISTRIBUTION_ID
# comes from (step 6, "Create the distribution").

# Required. The CloudFront distribution ID to invalidate after each deploy.
CLOUDFRONT_DISTRIBUTION_ID=

# Optional. Defaults shown - override only if you created the bucket under a
# different name or region.
FRONTEND_BUCKET=dryroute-frontend
AWS_REGION=ap-southeast-1
