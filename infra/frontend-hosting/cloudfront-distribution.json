{
  "CallerReference": "dryroute-frontend-hosting",
  "Comment": "DryRoute frontend: S3 static origin plus /api and /tiles routed to their own origins",
  "Enabled": true,
  "DefaultRootObject": "index.html",
  "PriceClass": "PriceClass_All",
  "HttpVersion": "http2and3",
  "Aliases": {
    "Quantity": 1,
    "Items": ["app.dryroute.com"]
  },
  "ViewerCertificate": {
    "ACMCertificateArn": "arn:aws:acm:us-east-1:102805382411:certificate/a52e0102-9bb6-4a33-93bd-6b332f24871b",
    "SSLSupportMethod": "sni-only",
    "MinimumProtocolVersion": "TLSv1.2_2021"
  },
  "Origins": {
    "Quantity": 3,
    "Items": [
      {
        "Id": "s3-frontend",
        "DomainName": "dryroute-frontend.s3.ap-southeast-1.amazonaws.com",
        "OriginAccessControlId": "E8FC113IG9XHZ",
        "S3OriginConfig": { "OriginAccessIdentity": "" }
      },
      {
        "Id": "backend-origin",
        "DomainName": "dryroute-production.up.railway.app",
        "CustomOriginConfig": {
          "HTTPPort": 80,
          "HTTPSPort": 443,
          "OriginProtocolPolicy": "https-only",
          "OriginSslProtocols": { "Quantity": 1, "Items": ["TLSv1.2"] }
        }
      },
      {
        "Id": "tiles-origin",
        "DomainName": "outstanding-nurturing-production-9dad.up.railway.app",
        "CustomOriginConfig": {
          "HTTPPort": 80,
          "HTTPSPort": 443,
          "OriginProtocolPolicy": "https-only",
          "OriginSslProtocols": { "Quantity": 1, "Items": ["TLSv1.2"] }
        }
      }
    ]
  },
  "DefaultCacheBehavior": {
    "TargetOriginId": "s3-frontend",
    "ViewerProtocolPolicy": "redirect-to-https",
    "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
    "Compress": true,
    "AllowedMethods": {
      "Quantity": 2,
      "Items": ["GET", "HEAD"],
      "CachedMethods": { "Quantity": 2, "Items": ["GET", "HEAD"] }
    }
  },
  "CacheBehaviors": {
    "Quantity": 2,
    "Items": [
      {
        "PathPattern": "/api/*",
        "TargetOriginId": "backend-origin",
        "ViewerProtocolPolicy": "redirect-to-https",
        "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
        "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
        "Compress": true,
        "AllowedMethods": {
          "Quantity": 7,
          "Items": ["GET", "HEAD", "OPTIONS", "PUT", "POST", "PATCH", "DELETE"],
          "CachedMethods": { "Quantity": 2, "Items": ["GET", "HEAD"] }
        },
        "FunctionAssociations": {
          "Quantity": 1,
          "Items": [
            { "EventType": "viewer-request", "FunctionARN": "arn:aws:cloudfront::102805382411:function/dryroute-strip-prefix" }
          ]
        }
      },
      {
        "PathPattern": "/tiles/*",
        "TargetOriginId": "tiles-origin",
        "ViewerProtocolPolicy": "redirect-to-https",
        "CachePolicyId": "411e26b9-df58-4cfa-adb5-36432301a515",
        "Compress": true,
        "AllowedMethods": {
          "Quantity": 2,
          "Items": ["GET", "HEAD"],
          "CachedMethods": { "Quantity": 2, "Items": ["GET", "HEAD"] }
        },
        "FunctionAssociations": {
          "Quantity": 1,
          "Items": [
            { "EventType": "viewer-request", "FunctionARN": "arn:aws:cloudfront::102805382411:function/dryroute-strip-prefix" }
          ]
        }
      }
    ]
  }
}
