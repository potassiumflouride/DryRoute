# lambda-radar-ingest/.env.example - copy to .env for local dev, never commit real values.

# data.gov.sg API key. Create one at https://data.gov.sg/signin -> Create API Key.
# The API works without a key at a lower rate limit; supplying one raises the limit.
NEA_API_KEY=

# S3 bucket the Lambda writes radar frames into. In deployed environments this is
# injected by template.yaml (!Ref RadarBucket) - only set it here for local testing
# against a real or moto-mocked bucket.
RADAR_BUCKET_NAME=

# NEA radar coverage range to fetch.
RADAR_RANGE=240km
