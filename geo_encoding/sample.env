# geo_encoding/sample.env - copy to geo_encoding/.env and fill in.
#   cp geo_encoding/sample.env geo_encoding/.env

# OneMap account credentials used to obtain the bearer token this gateway
# injects into proxied requests. Register at https://www.onemap.gov.sg.
GEO_ENCODING_ONEMAP_EMAIL=
GEO_ENCODING_ONEMAP_PASSWORD=

# --- Everything below has a working default; only set it if you need to change it. ---
# GEO_ENCODING_ONEMAP_BASE_URL=https://www.onemap.gov.sg
# GEO_ENCODING_ONEMAP_TOKEN_URL=https://www.onemap.gov.sg/api/auth/post/getToken
# GEO_ENCODING_TOKEN_REFRESH_BUFFER_SECONDS=3600
# GEO_ENCODING_TOKEN_REFRESH_CHECK_INTERVAL_SECONDS=300
# GEO_ENCODING_RATE_LIMIT_MAX_CALLS=250
# GEO_ENCODING_RATE_LIMIT_WINDOW_SECONDS=60
# GEO_ENCODING_UPSTREAM_TIMEOUT_SECONDS=10
# GEO_ENCODING_ONEMAP_RETRY_MAX_ATTEMPTS=5
# GEO_ENCODING_ONEMAP_RETRY_BACKOFF_SECONDS=2
