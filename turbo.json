{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@dryroute/api#build": {
      "outputs": []
    },
    "lint": {},
    "test": {
      "dependsOn": ["build"]
    }
  }
}
