# Copy this file to test_load/.env and set only the targets used by your profile.
# URLs must point at services you are authorized to load test.

LOAD_ROUTE_URL=
LOAD_GEOCODE_URL=
LOAD_GEOCODE_STYLE=backend
LOAD_TILES_BASE_URL=
LOAD_TILES_ARCHIVE=dryroute
LOAD_TILES_PATH_TEMPLATE=/{archive}/{z}/{x}/{y}.mvt

# Optional JSON objects containing per-service request headers.
# Do not commit real credentials.
LOAD_ROUTE_HEADERS_JSON={}
LOAD_GEOCODE_HEADERS_JSON={}
LOAD_TILES_HEADERS_JSON={}

# Workload tuning. CLI flags override these values.
LOAD_PROFILE=mixed
LOAD_DURATION_SECONDS=300
LOAD_MAX_USERS=50
LOAD_THINK_TIME_MIN_SECONDS=1
LOAD_THINK_TIME_MAX_SECONDS=3
LOAD_TILES_PER_VIEW=8
LOAD_REQUEST_TIMEOUT_SECONDS=15
LOAD_RANDOM_SEED=20260827

# Practical initial service-level objectives, in seconds.
LOAD_MAX_ERROR_RATE=0.01
LOAD_ROUTE_P95_SECONDS=3
LOAD_GEOCODE_P95_SECONDS=2
LOAD_TILES_P95_SECONDS=0.5
